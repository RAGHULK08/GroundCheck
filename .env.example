# GroundCheck Environment Configuration
# Note: Google AI Studio automatically provides and injects the GEMINI_API_KEY.
# All settings below have sensible built-in defaults in the application code.
# You do NOT need to provide or enter any environment variables to run this app.

# --- Optional Overrides ---
# Chat model used for claim checking (default: gemini-3.1-flash-lite)
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Embedding model used for semantic similarity (default: gemini-embedding-2)
# GEMINI_EMBED_MODEL=gemini-embedding-2

# Grounding threshold (default: 0.60; can also be adjusted in UI)
# GROUNDCHECK_THRESHOLD=0.60

# Web search enable flag (default: true; can also be toggled in UI)
# VERIFIER_ENABLE_WEB_SEARCH=true

# Web retrieval similarity threshold (default: 0.50)
# WEB_RETRIEVAL_THRESHOLD=0.50

# --- Optional Search Providers ---
# Web search provider: duckduckgo (built-in default), tavily, brave, or searxng
# SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=
