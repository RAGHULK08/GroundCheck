# Copy this file to .env (git-ignored) and fill in real values. Never commit real secrets here.

# --- Gemini (required) ---
# Google AI Studio API key used server-side for embeddings, NLI, search terms and Google Search grounding.
GEMINI_API_KEY=your-gemini-api-key-here
# Chat model for every generateContent call (NLI judge, search terms, Google Search grounding). Optional; this is the default.
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Free-tier quotas are small (e.g. 20 requests/day for some models); run `npm run models` to list alternatives.
# Embedding model for every embedContent call. Optional; this is the default. Changing it invalidates cached embeddings.
GEMINI_EMBED_MODEL=gemini-embedding-2
# Successful Gemini results are cached in .cache/gemini-cache.json to save quota. Set to off to disable.
# GEMINI_CACHE=on

# --- Exasol Personal connection (reserved: not read by the app yet; data is stored in browser localStorage) ---
# Exasol host name or IP address.
EXASOL_HOST=your-exasol-host
# Exasol port (Exasol default is 8563).
EXASOL_PORT=8563
# Exasol database user.
EXASOL_USER=your-exasol-user
# Exasol database password.
EXASOL_PASSWORD=your-exasol-password
# Exasol schema that holds the KNOWLEDGE_BASE and CHECKS tables.
EXASOL_SCHEMA=GROUNDCHECK
# Use TLS for the Exasol connection (true or false).
EXASOL_ENCRYPTION=true

# --- Verification settings (reserved: the UI threshold setting is used today) ---
# Similarity threshold (0 to 1) a claim needs to be grounded by the knowledge base.
GROUNDCHECK_THRESHOLD=0.60
# Enable web search for verification by default (true or false).
VERIFIER_ENABLE_WEB_SEARCH=true
# Minimum claim-to-web-snippet similarity (0 to 1) before web evidence is considered.
WEB_RETRIEVAL_THRESHOLD=0.50

# --- Web search provider (keeps web search off the Gemini chat quota) ---
# tavily | brave | searxng | gemini. If unset: tavily when TAVILY_API_KEY is set, else gemini
# (Google Search grounding, which spends GEMINI_CHAT_MODEL quota).
# SEARCH_PROVIDER=tavily
# Tavily API key (free plan: 1,000 searches/month, no card): https://app.tavily.com
# TAVILY_API_KEY=tvly-your-tavily-api-key
# Brave Search API key (SEARCH_PROVIDER=brave).
# BRAVE_API_KEY=your-brave-api-key
# Self-hosted SearXNG base URL with JSON output enabled (SEARCH_PROVIDER=searxng).
# SEARXNG_URL=http://localhost:8080

# --- Optional keys (reserved: not read by the app yet) ---
# Anthropic API key for proxy mode.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI API key for proxy mode.
# OPENAI_API_KEY=your-openai-api-key
